#!/usr/bin/env bash
# bash 3.2 compatible; remote commands are quoted for a POSIX shell.

PROGRAM=${0##*/}
HOSTS=()
REGISTERED_HOSTS=()
HOSTS_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/tmuxer/hosts
SCAN_PIDS=()
SCAN_DIR=
LOCAL_HOST='[local]'

usage() {
    printf '%s\n' \
        "Usage: $PROGRAM [tmux arguments...]" \
        "       $PROGRAM remote [subcommand]" \
        "  $PROGRAM                         Equivalent to tmux (including its default command)" \
        "  $PROGRAM ls                      Equivalent to tmux ls" \
        "  $PROGRAM remote                  Select a local or remote session (requires fzf)" \
        "  $PROGRAM remote select           Select a local or remote session (requires fzf)" \
        "  $PROGRAM remote list             List registered remote hosts without connecting" \
        "  $PROGRAM remote candidates       List SSH aliases available for registration" \
        "  $PROGRAM remote register host [host ...]  Add remote hosts to the allow list" \
        "  $PROGRAM remote exec host [tmux arguments...]  Run tmux on a registered SSH host" \
        "  $PROGRAM remote sessions         List local and registered remote sessions" \
        "  $PROGRAM remote help             Show remote command help" \
        "  $PROGRAM help                    Show help"
}

remote_usage() {
    printf '%s\n' \
        "Usage: $PROGRAM remote [subcommand]" \
        "  $PROGRAM remote                  Select a local or remote session (requires fzf)" \
        "  $PROGRAM remote select           Select a local or remote session (requires fzf)" \
        "  $PROGRAM remote list             List every registered host, one per line" \
        "  $PROGRAM remote candidates       List SSH aliases available for registration" \
        "  $PROGRAM remote register host [host ...]  Add remote hosts to the allow list" \
        "  $PROGRAM remote exec host [tmux arguments...]  Run tmux on a registered SSH host" \
        "  $PROGRAM remote sessions [tmux global options...]  List local and remote sessions" \
        "  $PROGRAM remote help             Show help" \
        "Allow list: $HOSTS_FILE" \
        'TR_HOSTS="a b c" filters registered hosts for discovery (empty means local only).'
}

fail() { printf '%s: %s\n' "$PROGRAM" "$*" >&2; exit 2; }

cleanup() {
    local pid
    for pid in "${SCAN_PIDS[@]}"; do kill "$pid" 2>/dev/null || :; done
    for pid in "${SCAN_PIDS[@]}"; do wait "$pid" 2>/dev/null || :; done
    SCAN_PIDS=()
    if [ -n "$SCAN_DIR" ]; then rm -rf -- "$SCAN_DIR"; SCAN_DIR=; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Each argument, including an empty argument, becomes one shell word.
quote_command() {
    local arg
    REMOTE_COMMAND=
    for arg in "$@"; do
        arg=${arg//\'/\'\\\'\'}
        REMOTE_COMMAND="${REMOTE_COMMAND}${REMOTE_COMMAND:+ }'$arg'"
    done
}

add_host() {
    local host=$1 existing
    [ -n "$host" ] || return
    for existing in "${HOSTS[@]}"; do [ "$existing" != "$host" ] || return; done
    HOSTS[${#HOSTS[@]}]=$host
}

valid_host() {
    case "$1" in
        ''|-*|all|*[!a-zA-Z0-9._@:%+-]*)
            return 1 ;;
    esac
}

validate_host() {
    valid_host "$1" || fail "invalid host: $1 (use an SSH alias, hostname, IP address, or user@host; all is reserved)"
}

host_is_registered() {
    local registered
    for registered in "${REGISTERED_HOSTS[@]}"; do
        [ "$registered" != "$1" ] || return 0
    done
    return 1
}

load_registered_hosts() {
    local host
    REGISTERED_HOSTS=()
    [ -e "$HOSTS_FILE" ] || [ -L "$HOSTS_FILE" ] || return 0
    [ -f "$HOSTS_FILE" ] && [ -r "$HOSTS_FILE" ] || fail "cannot read allow list: $HOSTS_FILE"
    while IFS= read -r host || [ -n "$host" ]; do
        case "$host" in ''|'#'*) continue ;; esac
        validate_host "$host"
        if ! host_is_registered "$host"; then
            REGISTERED_HOSTS[${#REGISTERED_HOSTS[@]}]=$host
        fi
    done < "$HOSTS_FILE" || fail "cannot read allow list: $HOSTS_FILE"
}

register_hosts() {
    local host directory last_char=
    local -a new_hosts
    new_hosts=()
    [ "$#" -gt 0 ] || fail 'remote register requires at least one host'
    # Validate the whole request before changing the allow list.
    for host in "$@"; do validate_host "$host"; done
    load_registered_hosts
    for host in "$@"; do
        if ! host_is_registered "$host"; then
            new_hosts[${#new_hosts[@]}]=$host
            REGISTERED_HOSTS[${#REGISTERED_HOSTS[@]}]=$host
        fi
    done
    if [ "${#new_hosts[@]}" -gt 0 ]; then
        directory=${HOSTS_FILE%/*}
        if [ -f "$HOSTS_FILE" ]; then
            last_char=$(tail -c 1 -- "$HOSTS_FILE") || fail "cannot read allow list: $HOSTS_FILE"
        fi
        # Append instead of replacing the file so concurrent registrations cannot
        # overwrite each other. Preserve a manually edited final unterminated line.
        (
            umask 077
            mkdir -p -- "$directory" || exit 1
            if [ -n "$last_char" ]; then printf '\n' >> "$HOSTS_FILE" || exit 1; fi
            printf '%s\n' "${new_hosts[@]}" >> "$HOSTS_FILE"
        ) || fail "cannot write allow list: $HOSTS_FILE"
    fi
    printf 'Registered: %s\n' "$@"
}

list_hosts() {
    load_registered_hosts
    if [ "${#REGISTERED_HOSTS[@]}" -gt 0 ]; then
        printf '%s\n' "${REGISTERED_HOSTS[@]}"
    fi
}

# Extract only Host and Include arguments, without evaluating SSH commands.
ssh_config_entries() {
    awk '
        {
            line = $0
            sub(/^[ \t\r]+/, "", line)
            if (!match(line, /^[^ \t=]+/)) next
            directive = tolower(substr(line, 1, RLENGTH))
            if (directive != "host" && directive != "include") next
            line = substr(line, RLENGTH + 1)
            sub(/^[ \t]*=?[ \t]*/, "", line)
            token = ""; quoted = 0
            for (i = 1; i <= length(line); i++) {
                char = substr(line, i, 1)
                if (char == "\\" && substr(line, i + 1, 1) ~ /["\\]/) {
                    token = token substr(line, ++i, 1)
                } else if (char == "\"") {
                    quoted = !quoted
                } else if (char == "#" && !quoted) {
                    break
                } else if (char ~ /[ \t\r]/ && !quoted) {
                    if (token != "") printf "%s\t%s\n", directive, token
                    token = ""
                } else {
                    token = token char
                }
            }
            if (quoted) exit 1
            if (token != "") printf "%s\t%s\n", directive, token
        }
    ' "$1"
}

read_ssh_candidates() {
    local config=$1 depth=$2 visited entries directive value included
    [ -e "$config" ] || [ -L "$config" ] || return 0
    [ -f "$config" ] && [ -r "$config" ] || fail "cannot read SSH config: $config"
    # Compare file identities so repeated includes and symlink cycles are safe.
    for visited in "${SSH_CONFIG_FILES[@]}"; do
        [ ! "$config" -ef "$visited" ] || return 0
    done
    [ "$depth" -le 16 ] || fail "SSH config includes are too deeply nested: $config"
    SSH_CONFIG_FILES[${#SSH_CONFIG_FILES[@]}]=$config
    entries=$(ssh_config_entries "$config") || fail "cannot parse SSH config: $config"
    while IFS=$'\t' read -r directive value; do
        case "$directive" in
            host) if valid_host "$value"; then add_host "$value"; fi ;;
            include)
                case "$value" in
                    \~/*) value=$HOME/${value#\~/} ;;
                    \~*) continue ;;
                    /*) ;;
                    *) value=$HOME/.ssh/$value ;;
                esac
                # Disable word splitting while expanding Include path globs.
                local IFS=
                # shellcheck disable=SC2086
                for included in $value; do
                    read_ssh_candidates "$included" "$((depth + 1))"
                done ;;
        esac
    done <<< "$entries"
}

list_candidates() (
    HOSTS=()
    SSH_CONFIG_FILES=()
    set +f
    shopt -s nullglob
    read_ssh_candidates "$HOME/.ssh/config" 0
    if [ "${#HOSTS[@]}" -gt 0 ]; then printf '%s\n' "${HOSTS[@]}"; fi
)

require_registered_host() {
    validate_host "$1"
    load_registered_hosts
    host_is_registered "$1" || fail "host is not registered: $1 (run: $PROGRAM remote register $1)"
}

get_hosts() {
    local host
    HOSTS=()
    load_registered_hosts
    if [ "${TR_HOSTS+x}" = x ]; then
        local IFS=$' \t\n'
        set -f
        for host in $TR_HOSTS; do
            if host_is_registered "$host"; then add_host "$host"; fi
        done
        set +f
    else
        HOSTS=("${REGISTERED_HOSTS[@]}")
    fi
}

# Return whether a global option token needs its following argument. Attached
# values (-Lsocket) and grouped flags (-vL socket) follow tmux's getopt syntax.
option_needs_value() {
    local token=$1 i char
    NEEDS_VALUE=0
    for ((i=1; i<${#token}; i++)); do
        char=${token:i:1}
        case "$char" in
            c|f|L|S|T)
                if [ "$i" -eq "$((${#token} - 1))" ]; then NEEDS_VALUE=1; fi
                return ;;
        esac
    done
}

scan_one() {
    trap - EXIT INT TERM HUP
    local host=$1 output
    if [ "$host" = "$LOCAL_HOST" ]; then
        output=$(tmux "${GLOBALS[@]}" list-sessions -F '#{session_name}:#{session_windows}:#{session_attached}' 2>/dev/null) || return 0
    else
        quote_command tmux "${GLOBALS[@]}" list-sessions -F '#{session_name}:#{session_windows}:#{session_attached}'
        output=$(ssh -T -o BatchMode=yes -o ConnectTimeout=3 -o ConnectionAttempts=1 -- "$host" "$REMOTE_COMMAND" 2>/dev/null) || return 0
    fi
    [ -n "$output" ] || return 0
    printf '%s\n' "$output" | awk -F ':' -v host="$host" \
        'NF == 3 { printf "%s\t%s\t%s\t%s\n", host, $1, $2, ($3 + 0 > 0 ? "attached" : "detached") }'
}

collect_sessions() {
    local index=0 host pid line
    get_hosts
    SCAN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/tr.XXXXXXXX") || fail 'cannot create temporary directory'
    for host in "$LOCAL_HOST" "${HOSTS[@]}"; do
        scan_one "$host" > "$SCAN_DIR/$index" &
        SCAN_PIDS[${#SCAN_PIDS[@]}]=$!
        index=$((index + 1))
    done
    for pid in "${SCAN_PIDS[@]}"; do wait "$pid" || :; done
    SCAN_PIDS=()
    : > "$SCAN_DIR/sessions"
    for ((index=0; index<=${#HOSTS[@]}; index++)); do
        while IFS= read -r line || [ -n "$line" ]; do
            printf '%s\n' "$line" >> "$SCAN_DIR/sessions"
        done < "$SCAN_DIR/$index"
    done
}

preview() {
    local host session windows state
    IFS=$'\t' read -r host session windows state <<< "$1"
    [ -n "$host" ] && [ -n "$session" ] || return 0
    if [ "$host" = "$LOCAL_HOST" ]; then
        tmux capture-pane -p -t "=$session:" -S -100 2>/dev/null
    else
        require_registered_host "$host"
        quote_command tmux capture-pane -p -t "=$session:" -S -100
        ssh -T -o BatchMode=yes -o ConnectTimeout=3 -o ConnectionAttempts=1 -- "$host" "$REMOTE_COMMAND" 2>/dev/null
    fi
}

select_session() {
    local selection host session windows state script_path quoted_script status
    command -v fzf >/dev/null 2>&1 || fail "interactive selection requires fzf; you can still run commands such as $PROGRAM remote sessions"
    collect_sessions
    if [ ! -s "$SCAN_DIR/sessions" ]; then
        printf '%s: no available sessions found\n' "$PROGRAM" >&2
        return 1
    fi
    script_path=$0
    case "$script_path" in */*) ;; *) script_path=$(command -v "$script_path") ;; esac
    script_path=$(CDPATH= cd -- "${script_path%/*}" && pwd)/${script_path##*/}
    quote_command "$script_path"
    quoted_script=$REMOTE_COMMAND
    selection=$(SHELL=/bin/sh fzf --delimiter "$TAB" --header "HOST${TAB}SESSION${TAB}WINDOWS${TAB}STATE" \
        --preview "TR_INTERNAL_PREVIEW=1 $quoted_script remote {}" --preview-window 'right:60%' < "$SCAN_DIR/sessions")
    status=$?
    [ "$status" -eq 0 ] && [ -n "$selection" ] || return "$status"
    IFS=$'\t' read -r host session windows state <<< "$selection"
    [ -n "$host" ] && [ -n "$session" ] || fail 'fzf returned an invalid session'
    cleanup
    if [ "$host" = "$LOCAL_HOST" ]; then
        if [ -n "${TMUX-}" ]; then exec tmux switch-client -t "=$session";
        else exec tmux attach -t "=$session"; fi
    else
        require_registered_host "$host"
        quote_command tmux attach -t "=$session"
        exec ssh -t -- "$host" "$REMOTE_COMMAND"
    fi
}

TAB=$'\t'
GLOBALS=()
ARGS=()
HOST=
OPERATION=
COMMAND=
if [ "${1-}" = help ]; then
    [ "$#" -eq 1 ] || fail 'help does not accept arguments'
    usage; exit 0
fi
if [ "${1-}" != remote ]; then cleanup; exec tmux "$@"; fi
shift
if [ "${TR_INTERNAL_PREVIEW-}" = 1 ]; then preview "${1-}"; exit $?; fi
if [ "$#" -eq 0 ]; then select_session; exit $?; fi
OPERATION=$1
shift
case "$OPERATION" in
    help)
        [ "$#" -eq 0 ] || fail 'remote help does not accept arguments'
        remote_usage; exit 0 ;;
    select)
        [ "$#" -eq 0 ] || fail 'remote select does not accept arguments'
        select_session; exit $? ;;
    register) register_hosts "$@"; exit 0 ;;
    list)
        [ "$#" -eq 0 ] || fail 'remote list does not accept arguments'
        list_hosts; exit 0 ;;
    candidates)
        [ "$#" -eq 0 ] || fail 'remote candidates does not accept arguments'
        list_candidates; exit $? ;;
    exec)
        [ "$#" -gt 0 ] && [ -n "$1" ] || fail 'remote exec requires a host argument'
        HOST=$1; shift
        require_registered_host "$HOST" ;;
    sessions) ;;
    *) fail "unknown remote subcommand: $OPERATION (run: $PROGRAM remote help)" ;;
esac
ARGS=("$@")

# Inspect tmux global options to find the command for terminal allocation and
# session discovery. Every argument is forwarded unchanged by remote exec.
while [ "$#" -gt 0 ]; do
    case "$1" in
        --)
            GLOBALS[${#GLOBALS[@]}]=$1; shift
            COMMAND=${1-}; break ;;
        -?*)
            TMUX_OPTION=$1
            option_needs_value "$TMUX_OPTION"
            GLOBALS[${#GLOBALS[@]}]=$1; shift
            if [ "$NEEDS_VALUE" = 1 ] && [ "$#" -gt 0 ]; then
                GLOBALS[${#GLOBALS[@]}]=$1; shift
            elif [ "$NEEDS_VALUE" = 1 ] && [ "$OPERATION" = sessions ]; then
                fail "tmux option $TMUX_OPTION requires a value"
            fi ;;
        *) COMMAND=$1; break ;;
    esac
done
if [ "$OPERATION" = sessions ]; then
    [ "$#" -eq 0 ] || fail 'remote sessions only accepts tmux global options'
    collect_sessions
    printf 'HOST\tSESSION\tWINDOWS\tSTATE\n'
    while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line"; done < "$SCAN_DIR/sessions"
    exit 0
fi
quote_command tmux "${ARGS[@]}"
cleanup
case "$COMMAND" in
    ''|attach|attach-session|a|at|new|new-session)
        if [ -t 0 ]; then exec ssh -t -- "$HOST" "$REMOTE_COMMAND"; fi ;;
esac
exec ssh -T -- "$HOST" "$REMOTE_COMMAND"
