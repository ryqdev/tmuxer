#!/usr/bin/env bash
# bash 3.2 compatible; remote commands are quoted for a POSIX shell.

PROGRAM=${0##*/}
HOSTS=()
REGISTERED_HOSTS=()
HOSTS_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/tmuxer/hosts
SCAN_PIDS=()
SCAN_DIR=
LOCAL_HOST='[local]'
HOSTS_LOCK=
HOSTS_TEMP=

usage() {
    printf '%s\n' \
        "Usage: $PROGRAM [tmux arguments...]" \
        "       $PROGRAM remote" \
        "       $PROGRAM remote @host [tmux arguments...]" \
        "       $PROGRAM hosts <subcommand>" \
        "  $PROGRAM                         Select a local session (requires fzf)" \
        "  $PROGRAM ls                      Equivalent to tmux ls" \
        "  $PROGRAM remote                  Select a session across registered SSH hosts (requires fzf)" \
        "  $PROGRAM remote @host            Select a session on one registered SSH host (requires fzf)" \
        "  $PROGRAM remote @host [tmux arguments...]  Run tmux on that SSH host" \
        "  $PROGRAM hosts list              List registered hosts without connecting" \
        "  $PROGRAM hosts candidates        List SSH aliases available for registration" \
        "  $PROGRAM hosts register host [host ...]  Add SSH config aliases to the allow list" \
        "  $PROGRAM hosts remove host [host ...]  Remove hosts from the allow list" \
        "  $PROGRAM hosts help              Show host management help" \
        "  $PROGRAM help                    Show help" \
        'Remote tmux commands require a leading @host; all remaining arguments go to tmux.'
}

hosts_usage() {
    printf '%s\n' \
        "Usage: $PROGRAM hosts <subcommand>" \
        "  $PROGRAM hosts list              List every registered host, one per line" \
        "  $PROGRAM hosts candidates        List SSH aliases available for registration" \
        "  $PROGRAM hosts register host [host ...]  Add SSH config aliases to the allow list" \
        "  $PROGRAM hosts remove host [host ...]  Remove hosts from the allow list" \
        "  $PROGRAM hosts help              Show help" \
        "Allow list: $HOSTS_FILE" \
        'TR_HOSTS="a b c" filters discovery by tx remote (empty means no available hosts).'
}

fail() { printf '%s: %s\n' "$PROGRAM" "$*" >&2; exit 2; }

cleanup() {
    local pid
    for pid in "${SCAN_PIDS[@]}"; do kill "$pid" 2>/dev/null || :; done
    for pid in "${SCAN_PIDS[@]}"; do wait "$pid" 2>/dev/null || :; done
    SCAN_PIDS=()
    if [ -n "$SCAN_DIR" ]; then rm -rf -- "$SCAN_DIR"; SCAN_DIR=; fi
    if [ -n "$HOSTS_TEMP" ]; then rm -f -- "$HOSTS_TEMP"; HOSTS_TEMP=; fi
    if [ -n "$HOSTS_LOCK" ]; then rmdir -- "$HOSTS_LOCK" 2>/dev/null || :; HOSTS_LOCK=; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# Each argument, including an empty argument, becomes one shell word.
quote_command() {
    local arg
    REMOTE_COMMAND=
    for arg in "$@"; do
        arg=${arg//\'/\'\\\'\'}
        REMOTE_COMMAND="${REMOTE_COMMAND}${REMOTE_COMMAND:+ }'$arg'"
    done
}

add_host() {
    local host=$1 existing
    [ -n "$host" ] || return
    for existing in "${HOSTS[@]}"; do [ "$existing" != "$host" ] || return; done
    HOSTS[${#HOSTS[@]}]=$host
}

valid_host() {
    case "$1" in
        ''|-*|all|*[!a-zA-Z0-9._@:%+-]*)
            return 1 ;;
    esac
}

validate_host() {
    valid_host "$1" || fail "invalid host: $1 (use an SSH alias, hostname, IP address, or user@host; all is reserved)"
}

host_is_registered() {
    local registered
    for registered in "${REGISTERED_HOSTS[@]}"; do
        [ "$registered" != "$1" ] || return 0
    done
    return 1
}

load_registered_hosts() {
    local host
    REGISTERED_HOSTS=()
    [ -e "$HOSTS_FILE" ] || [ -L "$HOSTS_FILE" ] || return 0
    [ -f "$HOSTS_FILE" ] && [ -r "$HOSTS_FILE" ] || fail "cannot read allow list: $HOSTS_FILE"
    while IFS= read -r host || [ -n "$host" ]; do
        case "$host" in ''|'#'*) continue ;; esac
        validate_host "$host"
        if ! host_is_registered "$host"; then
            REGISTERED_HOSTS[${#REGISTERED_HOSTS[@]}]=$host
        fi
    done < "$HOSTS_FILE" || fail "cannot read allow list: $HOSTS_FILE"
}

lock_hosts_file() {
    local directory=${HOSTS_FILE%/*} lock=$HOSTS_FILE.lock attempts=0
    (umask 077; mkdir -p -- "$directory") || fail "cannot write allow list: $HOSTS_FILE"
    # Serialize register/remove so replacing the file cannot lose an append.
    while ! (umask 077; mkdir -- "$lock") 2>/dev/null; do
        attempts=$((attempts + 1))
        [ "$attempts" -lt 100 ] || fail "timed out locking allow list: $HOSTS_FILE"
        sleep 0.05
    done
    HOSTS_LOCK=$lock
}

register_hosts() {
    local host candidate candidates found directory last_char=
    local -a new_hosts
    new_hosts=()
    [ "$#" -gt 0 ] || fail 'hosts register requires at least one host'
    # Validate the whole request before changing the allow list.
    for host in "$@"; do validate_host "$host"; done
    candidates=$(list_candidates) || exit $?
    for host in "$@"; do
        found=0
        while IFS= read -r candidate; do
            if [ "$host" = "$candidate" ]; then found=1; break; fi
        done <<< "$candidates"
        [ "$found" = 1 ] || fail "host is not an SSH config candidate: $host (run: $PROGRAM hosts candidates)"
    done
    lock_hosts_file
    load_registered_hosts
    for host in "$@"; do
        if ! host_is_registered "$host"; then
            new_hosts[${#new_hosts[@]}]=$host
            REGISTERED_HOSTS[${#REGISTERED_HOSTS[@]}]=$host
        fi
    done
    if [ "${#new_hosts[@]}" -gt 0 ]; then
        directory=${HOSTS_FILE%/*}
        if [ -f "$HOSTS_FILE" ]; then
            last_char=$(tail -c 1 -- "$HOSTS_FILE") || fail "cannot read allow list: $HOSTS_FILE"
        fi
        # Append without rewriting comments or existing entries. Preserve a
        # manually edited final unterminated line.
        (
            umask 077
            mkdir -p -- "$directory" || exit 1
            if [ -n "$last_char" ]; then printf '\n' >> "$HOSTS_FILE" || exit 1; fi
            printf '%s\n' "${new_hosts[@]}" >> "$HOSTS_FILE"
        ) || fail "cannot write allow list: $HOSTS_FILE"
    fi
    printf 'Registered: %s\n' "$@"
}

remove_hosts() {
    local host line remove target link depth=0
    [ "$#" -gt 0 ] || fail 'hosts remove requires at least one host'
    for host in "$@"; do validate_host "$host"; done
    if [ ! -e "$HOSTS_FILE" ] && [ ! -L "$HOSTS_FILE" ]; then
        fail "host is not registered: $1 (run: $PROGRAM hosts list)"
    fi
    lock_hosts_file
    load_registered_hosts
    for host in "$@"; do
        host_is_registered "$host" || fail "host is not registered: $host (run: $PROGRAM hosts list)"
    done

    # Replace a symlink's target, preserving the link used for configuration.
    target=$HOSTS_FILE
    while [ -L "$target" ]; do
        depth=$((depth + 1))
        [ "$depth" -le 40 ] || fail "too many allow-list symlinks: $HOSTS_FILE"
        link=$(readlink "$target") || fail "cannot read allow list: $HOSTS_FILE"
        case "$link" in /*) target=$link ;; *) target=${target%/*}/$link ;; esac
    done
    HOSTS_TEMP=$(mktemp "${target%/*}/.tmuxer-hosts.XXXXXXXX") || fail "cannot write allow list: $HOSTS_FILE"
    # Preserve comments, blank lines, and the order of every retained entry.
    (
        while IFS= read -r line || [ -n "$line" ]; do
            remove=0
            for host in "$@"; do
                if [ "$line" = "$host" ]; then remove=1; break; fi
            done
            if [ "$remove" = 0 ]; then printf '%s\n' "$line" || exit 1; fi
        done < "$HOSTS_FILE"
    ) > "$HOSTS_TEMP" || fail "cannot write allow list: $HOSTS_FILE"
    mv -f -- "$HOSTS_TEMP" "$target" || fail "cannot write allow list: $HOSTS_FILE"
    HOSTS_TEMP=
    printf 'Removed: %s\n' "$@"
}

list_hosts() {
    load_registered_hosts
    if [ "${#REGISTERED_HOSTS[@]}" -gt 0 ]; then
        printf '%s\n' "${REGISTERED_HOSTS[@]}"
    fi
}

# Extract only Host and Include arguments, without evaluating SSH commands.
ssh_config_entries() {
    awk '
        {
            line = $0
            sub(/^[ \t\r]+/, "", line)
            if (!match(line, /^[^ \t=]+/)) next
            directive = tolower(substr(line, 1, RLENGTH))
            if (directive != "host" && directive != "include") next
            line = substr(line, RLENGTH + 1)
            sub(/^[ \t]*=?[ \t]*/, "", line)
            token = ""; quoted = 0
            for (i = 1; i <= length(line); i++) {
                char = substr(line, i, 1)
                if (char == "\\" && substr(line, i + 1, 1) ~ /["\\]/) {
                    token = token substr(line, ++i, 1)
                } else if (char == "\"") {
                    quoted = !quoted
                } else if (char == "#" && !quoted) {
                    break
                } else if (char ~ /[ \t\r]/ && !quoted) {
                    if (token != "") printf "%s\t%s\n", directive, token
                    token = ""
                } else {
                    token = token char
                }
            }
            if (quoted) exit 1
            if (token != "") printf "%s\t%s\n", directive, token
        }
    ' "$1"
}

read_ssh_candidates() {
    local config=$1 depth=$2 visited entries directive value included
    [ -e "$config" ] || [ -L "$config" ] || return 0
    [ -f "$config" ] && [ -r "$config" ] || fail "cannot read SSH config: $config"
    # Compare file identities so repeated includes and symlink cycles are safe.
    for visited in "${SSH_CONFIG_FILES[@]}"; do
        [ ! "$config" -ef "$visited" ] || return 0
    done
    [ "$depth" -le 16 ] || fail "SSH config includes are too deeply nested: $config"
    SSH_CONFIG_FILES[${#SSH_CONFIG_FILES[@]}]=$config
    entries=$(ssh_config_entries "$config") || fail "cannot parse SSH config: $config"
    while IFS=$'\t' read -r directive value; do
        case "$directive" in
            host) if valid_host "$value"; then add_host "$value"; fi ;;
            include)
                case "$value" in
                    \~/*) value=$HOME/${value#\~/} ;;
                    \~*) continue ;;
                    /*) ;;
                    *) value=$HOME/.ssh/$value ;;
                esac
                # Disable word splitting while expanding Include path globs.
                local IFS=
                # shellcheck disable=SC2086
                for included in $value; do
                    read_ssh_candidates "$included" "$((depth + 1))"
                done ;;
        esac
    done <<< "$entries"
}

list_candidates() (
    HOSTS=()
    SSH_CONFIG_FILES=()
    set +f
    shopt -s nullglob
    read_ssh_candidates "$HOME/.ssh/config" 0
    if [ "${#HOSTS[@]}" -gt 0 ]; then printf '%s\n' "${HOSTS[@]}"; fi
)

require_registered_host() {
    validate_host "$1"
    load_registered_hosts
    host_is_registered "$1" || fail "host is not registered: $1 (run: $PROGRAM hosts register $1)"
}

get_hosts() {
    local host
    HOSTS=()
    load_registered_hosts
    if [ "${TR_HOSTS+x}" = x ]; then
        local IFS=$' \t\n'
        set -f
        for host in $TR_HOSTS; do
            if host_is_registered "$host"; then add_host "$host"; fi
        done
        set +f
    else
        HOSTS=("${REGISTERED_HOSTS[@]}")
    fi
}

# Return whether a global option token needs its following argument. Attached
# values (-Lsocket) and grouped flags (-vL socket) follow tmux's getopt syntax.
option_needs_value() {
    local token=$1 i char
    NEEDS_VALUE=0
    for ((i=1; i<${#token}; i++)); do
        char=${token:i:1}
        case "$char" in
            c|f|L|S|T)
                if [ "$i" -eq "$((${#token} - 1))" ]; then NEEDS_VALUE=1; fi
                return ;;
        esac
    done
}

scan_one() {
    trap - EXIT INT TERM HUP
    local host=$1 scope=$2 output
    if [ "$scope" = local ]; then
        output=$(tmux list-sessions -F '#{session_name}:#{session_windows}:#{session_attached}' 2>/dev/null) || return 0
    else
        quote_command tmux list-sessions -F '#{session_name}:#{session_windows}:#{session_attached}'
        if [ "$scope" = host ]; then
            # One explicit server can use normal SSH authentication and report errors.
            output=$(ssh -T -- "$host" "$REMOTE_COMMAND" </dev/null) || return $?
        else
            # Cross-server discovery must not prompt for passwords or block on an offline host.
            output=$(ssh -T -o BatchMode=yes -o ConnectTimeout=3 -o ConnectionAttempts=1 -- "$host" "$REMOTE_COMMAND" </dev/null 2>/dev/null) || return 0
        fi
    fi
    [ -n "$output" ] || return 0
    printf '%s\n' "$output" | awk -F ':' -v host="$host" \
        'NF == 3 { printf "%s\t%s\t%s\t%s\n", host, $1, $2, ($3 + 0 > 0 ? "attached" : "detached") }'
}

collect_sessions() {
    local scope=$1 index=0 host pid line
    SCAN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/tr.XXXXXXXX") || fail 'cannot create temporary directory'
    if [ "$scope" = host ]; then
        (scan_one "${HOSTS[0]}" "$scope") > "$SCAN_DIR/0" || return $?
    else
        for host in "${HOSTS[@]}"; do
            scan_one "$host" "$scope" > "$SCAN_DIR/$index" &
            SCAN_PIDS[${#SCAN_PIDS[@]}]=$!
            index=$((index + 1))
        done
        for pid in "${SCAN_PIDS[@]}"; do wait "$pid" || :; done
        SCAN_PIDS=()
    fi
    : > "$SCAN_DIR/sessions"
    for ((index=0; index<${#HOSTS[@]}; index++)); do
        while IFS= read -r line || [ -n "$line" ]; do
            printf '%s\n' "$line" >> "$SCAN_DIR/sessions"
        done < "$SCAN_DIR/$index"
    done
}

preview() {
    local scope=$1 host session windows state
    IFS=$'\t' read -r host session windows state <<< "$2"
    [ -n "$host" ] && [ -n "$session" ] || return 0
    if [ "$scope" = local ]; then
        [ "$host" = "$LOCAL_HOST" ] || fail 'invalid local preview'
        tmux capture-pane -p -t "=$session:" -S -100 2>/dev/null
    else
        require_registered_host "$host"
        quote_command tmux capture-pane -p -t "=$session:" -S -100
        ssh -T -o BatchMode=yes -o ConnectTimeout=3 -o ConnectionAttempts=1 -- "$host" "$REMOTE_COMMAND" </dev/null 2>/dev/null
    fi
}

select_session() {
    local scope=$1 selection host session windows state script_path quoted_script status line found=0 fallback
    if [ "$scope" = local ]; then
        HOSTS=("$LOCAL_HOST")
        fallback="$PROGRAM ls"
    else
        if [ "$scope" = host ]; then HOSTS=("$2"); else get_hosts; fi
        if [ "${#HOSTS[@]}" -eq 0 ]; then
            printf '%s: no registered hosts available (run: %s hosts register host; check TR_HOSTS)\n' "$PROGRAM" "$PROGRAM" >&2
            return 1
        fi
        fallback="$PROGRAM remote @host ls"
        if { [ ! -t 0 ] && [ ! -t 2 ]; } || ! ( : < /dev/tty ) 2>/dev/null; then
            fail "session selection requires an interactive terminal; run a command such as $fallback"
        fi
    fi
    command -v fzf >/dev/null 2>&1 || fail "interactive selection requires fzf; you can still run commands such as $fallback"
    collect_sessions "$scope" || return $?
    if [ ! -s "$SCAN_DIR/sessions" ]; then
        printf '%s: no available sessions found\n' "$PROGRAM" >&2
        return 1
    fi
    script_path=$0
    case "$script_path" in */*) ;; *) script_path=$(command -v "$script_path") ;; esac
    script_path=$(CDPATH= cd -- "${script_path%/*}" && pwd)/${script_path##*/}
    quote_command "$script_path"
    quoted_script=$REMOTE_COMMAND
    selection=$(SHELL=/bin/sh fzf --no-multi --delimiter "$TAB" --header "HOST${TAB}SESSION${TAB}WINDOWS${TAB}STATE" \
        --preview "TR_INTERNAL_PREVIEW=1 $quoted_script remote $scope {}" --preview-window 'right:60%' < "$SCAN_DIR/sessions")
    status=$?
    [ "$status" -eq 0 ] || return "$status"
    [ -n "$selection" ] || return 1
    while IFS= read -r line; do
        if [ "$line" = "$selection" ]; then found=1; break; fi
    done < "$SCAN_DIR/sessions"
    [ "$found" = 1 ] || fail 'fzf returned an invalid session'
    IFS=$'\t' read -r host session windows state <<< "$selection"
    [ -n "$session" ] || fail 'fzf returned an invalid session'
    cleanup
    if [ "$scope" = local ]; then
        if [ -n "${TMUX-}" ]; then exec tmux switch-client -t "=$session";
        else exec tmux attach -t "=$session"; fi
    else
        # Registration may have changed while the picker was open.
        require_registered_host "$host"
        quote_command tmux attach -t "=$session"
        if [ -t 0 ]; then exec ssh -t -- "$host" "$REMOTE_COMMAND"; fi
        exec ssh -T -- "$host" "$REMOTE_COMMAND"
    fi
}

TAB=$'\t'
ARGS=()
HOST=
OPERATION=
COMMAND=
if [ "${1-}" = help ]; then
    [ "$#" -eq 1 ] || fail 'help does not accept arguments'
    usage; exit 0
fi
if [ "$#" -eq 0 ]; then select_session local; exit $?; fi
if [ "${1-}" = hosts ]; then
    shift
    OPERATION=${1-help}
    [ "$#" -eq 0 ] || shift
    case "$OPERATION" in
        help)
            [ "$#" -eq 0 ] || fail 'hosts help does not accept arguments'
            hosts_usage; exit 0 ;;
        register) register_hosts "$@"; exit 0 ;;
        remove) remove_hosts "$@"; exit 0 ;;
        list)
            [ "$#" -eq 0 ] || fail 'hosts list does not accept arguments'
            list_hosts; exit 0 ;;
        candidates)
            [ "$#" -eq 0 ] || fail 'hosts candidates does not accept arguments'
            list_candidates; exit $? ;;
        *) fail "unknown hosts subcommand: $OPERATION (run: $PROGRAM hosts help)" ;;
    esac
fi
if [ "${1-}" != remote ]; then cleanup; exec tmux "$@"; fi
shift
if [ "${TR_INTERNAL_PREVIEW-}" = 1 ]; then
    [ "$#" -eq 2 ] || fail 'invalid preview arguments'
    case "$1" in local|remote|host) ;; *) fail 'invalid preview scope' ;; esac
    preview "$1" "$2"; exit $?
fi
if [ "$#" -eq 0 ]; then select_session remote; exit $?; fi
case "${1-}" in
    @*)
        HOST=${1#@}; shift
        require_registered_host "$HOST" ;;
    *) fail "remote tmux commands require a server reference (run: $PROGRAM remote @host $*)" ;;
esac
if [ "$#" -eq 0 ]; then select_session host "$HOST"; exit $?; fi
ARGS=("$@")

# Inspect tmux global options only to decide whether SSH needs a terminal.
# Every tmux argument is forwarded unchanged.
while [ "$#" -gt 0 ]; do
    case "$1" in
        --)
            shift
            COMMAND=${1-}; break ;;
        -?*)
            TMUX_OPTION=$1
            option_needs_value "$TMUX_OPTION"
            shift
            if [ "$NEEDS_VALUE" = 1 ] && [ "$#" -gt 0 ]; then
                shift
            fi ;;
        *) COMMAND=$1; break ;;
    esac
done
quote_command tmux "${ARGS[@]}"
cleanup
case "$COMMAND" in
    ''|attach|attach-session|a|at|new|new-session)
        if [ -t 0 ]; then exec ssh -t -- "$HOST" "$REMOTE_COMMAND"; fi ;;
esac
exec ssh -T -- "$HOST" "$REMOTE_COMMAND"
